    ["Memory Optimized"]="r7i.large r7i.xlarge r7i.2xlarge r7i.4xlarge"
    ["Burstable"]="t3.nano t3.micro t3.small t3.medium t3.large t3.xlarge t3.2xlarge"
)
# Optional inline caveat printed next to a group header / above its type list.
declare -A INSTANCE_GROUP_CAVEATS=(
    ["Burstable"]="baseline CPU + credits; not recommended for sustained database load"
)
# Per-type vCPU/RAM annotations shown after each type name in the menu.
# Every type in INSTANCE_GROUP_TYPES must have a matching entry here.
declare -A INSTANCE_TYPE_SPECS=(
    ["m7i.large"]="2 vCPU, 8 GB"
    ["m7i.xlarge"]="4 vCPU, 16 GB"
    ["m7i.2xlarge"]="8 vCPU, 32 GB"
    ["m7i.4xlarge"]="16 vCPU, 64 GB"
    ["m7i.8xlarge"]="32 vCPU, 128 GB"
    ["c7i.large"]="2 vCPU, 4 GB"
    ["c7i.xlarge"]="4 vCPU, 8 GB"
    ["c7i.2xlarge"]="8 vCPU, 16 GB"
    ["c7i.4xlarge"]="16 vCPU, 32 GB"
    ["c7i.8xlarge"]="32 vCPU, 64 GB"
    ["c6i.xlarge"]="4 vCPU, 8 GB"
    ["c6i.2xlarge"]="8 vCPU, 16 GB"
    ["c6i.4xlarge"]="16 vCPU, 32 GB"
    ["c6i.8xlarge"]="32 vCPU, 64 GB"
    ["c5.xlarge"]="4 vCPU, 8 GB"
    ["c5.2xlarge"]="8 vCPU, 16 GB"
    ["c5.4xlarge"]="16 vCPU, 32 GB"
    ["c5.9xlarge"]="36 vCPU, 72 GB"
    ["r7i.large"]="2 vCPU, 16 GB"
    ["r7i.xlarge"]="4 vCPU, 32 GB"
    ["r7i.2xlarge"]="8 vCPU, 64 GB"
    ["r7i.4xlarge"]="16 vCPU, 128 GB"
    ["t3.nano"]="2 vCPU, 0.5 GB"
    ["t3.micro"]="2 vCPU, 1 GB"
    ["t3.small"]="2 vCPU, 2 GB"
    ["t3.medium"]="2 vCPU, 4 GB"
    ["t3.large"]="2 vCPU, 8 GB"
    ["t3.xlarge"]="4 vCPU, 16 GB"
    ["t3.2xlarge"]="8 vCPU, 32 GB"
)
DEFAULT_INSTANCE_TYPE="c7i.4xlarge"

# arm64 (Graviton) counterparts, offered when the selected OS entry declares
# arch: arm64. Same four groups; specs from `aws ec2 describe-instance-types`.
declare -A ARM64_INSTANCE_GROUP_TYPES=(
    ["General Purpose"]="m7g.large m7g.xlarge m7g.2xlarge m7g.4xlarge m7g.8xlarge"
    ["Compute Optimized"]="c7g.large c7g.xlarge c7g.2xlarge c7g.4xlarge c7g.8xlarge"
    ["Memory Optimized"]="r7g.large r7g.xlarge r7g.2xlarge r7g.4xlarge"
    ["Burstable"]="t4g.nano t4g.micro t4g.small t4g.medium t4g.large t4g.xlarge t4g.2xlarge"
)
INSTANCE_TYPE_SPECS+=(
    ["m7g.large"]="2 vCPU, 8 GB"
    ["m7g.xlarge"]="4 vCPU, 16 GB"
    ["m7g.2xlarge"]="8 vCPU, 32 GB"
    ["m7g.4xlarge"]="16 vCPU, 64 GB"
    ["m7g.8xlarge"]="32 vCPU, 128 GB"
    ["c7g.large"]="2 vCPU, 4 GB"
    ["c7g.xlarge"]="4 vCPU, 8 GB"
    ["c7g.2xlarge"]="8 vCPU, 16 GB"
    ["c7g.4xlarge"]="16 vCPU, 32 GB"
    ["c7g.8xlarge"]="32 vCPU, 64 GB"
    ["r7g.large"]="2 vCPU, 16 GB"
