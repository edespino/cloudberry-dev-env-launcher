            echo -n -e "${YELLOW}   Enter Cloudflare Zone ID (or press Enter to skip): ${NC}"
            read -r cloudflare_zone_id

            if [[ -n "$cloudflare_zone_id" ]]; then
                sed -i.bak "s|__CLOUDFLARE_ZONE_ID__|$cloudflare_zone_id|g" "$tfvars_file"
                rm -f "$tfvars_file.bak"
                echo -e "${GREEN}   ✅ Cloudflare Zone ID configured${NC}"
            else
                echo -e "${YELLOW}   ⚠️  Skipped - You can set this later in terraform.tfvars${NC}"
            fi
        fi

        # Copy external access setup guide
        if [[ -f "$TEMPLATE_DIR/EXTERNAL-ACCESS-SETUP.md.template" ]]; then
            cp "$TEMPLATE_DIR/EXTERNAL-ACCESS-SETUP.md.template" "$target_dir/EXTERNAL-ACCESS-SETUP.md"
            echo -e "${GREEN}   ✅ External access documentation copied${NC}"
        fi

        # Copy helm configuration files
        local helm_config_source="$REPO_ROOT/modules/aws/dbaas-platform/helm-config"
        if [[ -d "$helm_config_source" ]]; then
            cp -r "$helm_config_source" "$target_dir/example"
            echo -e "${GREEN}   ✅ Helm configuration files copied to example/${NC}"
        else
            echo -e "${YELLOW}   ⚠️  Helm config directory not found: $helm_config_source${NC}"
        fi

        # Copy DBaaS documentation
        local docs_source="$REPO_ROOT/modules/aws/dbaas-platform/docs"
        if [[ -d "$docs_source" ]]; then
            cp -r "$docs_source" "$target_dir/docs"
            echo -e "${GREEN}   ✅ DBaaS documentation copied to docs/${NC}"
        else
            echo -e "${YELLOW}   ⚠️  Docs directory not found: $docs_source${NC}"
        fi

        # NOTE: DBaaS platform module is now included in the multi-os-sample template
        # with conditional count (count = var.deploy_dbaas_services ? 1 : 0)
        # No need to append it here anymore - the module declaration is always present
        echo -e "${GREEN}   ✅ DBaaS platform module already present in template${NC}"
    fi

    echo -e "${GREEN}✨ Environment created successfully!${NC}"
    echo
    echo -e "${YELLOW}📁 Location:${NC} $target_dir"
    echo -e "${YELLOW}🔧 Next steps:${NC}"
    echo -e "  1. ${CYAN}cd $target_dir${NC}"
    echo -e "  2. ${CYAN}direnv allow .${NC}"

    if [[ "$deploy_dbaas" == "true" ]]; then
        # Calculate expected env_prefix (matches .envrc logic)
        local expected_env_prefix="${USER}"
        if [[ -n "$subdirectory" ]]; then
            expected_env_prefix="${expected_env_prefix}-${subdirectory}"
        fi
        expected_env_prefix="${expected_env_prefix}-${target_name}"

        echo -e "  3. ${CYAN}export TF_VAR_cloudflare_api_token=\"your-api-token\"${NC} ${PURPLE}(required for external access)${NC}"
        echo -e "  4. ${CYAN}terraform init${NC}"
        echo -e "  5. ${CYAN}terraform plan${NC}"
        echo -e "  6. ${CYAN}terraform apply${NC}"
        echo
        echo -e "${PURPLE}📚 DBaaS Platform:${NC}"
        echo -e "   • External access enabled by default (ALB + Cloudflare DNS)"
        echo -e "   • Auto-generated domain: ${CYAN}synxdb-${expected_env_prefix}.synxdata.com${NC}"
        echo -e "   • See EXTERNAL-ACCESS-SETUP.md for configuration details"
    else
        echo -e "  3. ${CYAN}terraform init${NC}"
        echo -e "  4. ${CYAN}terraform plan${NC}"
        echo -e "  5. ${CYAN}terraform apply${NC}"
    fi
    echo
}

# Function to get OS selection
get_os_selection() {
    while true; do
        show_options
        
        local max_choice=${#SELECTION_MAP[@]}
        echo -n -e "${YELLOW}Select an OS [1-${max_choice}] or 'q' to quit: ${NC}"
        read -r selection
        
        # Check for quit
        if [[ "$selection" == "q" || "$selection" == "Q" ]]; then
            echo -e "${YELLOW}👋 Goodbye!${NC}"
            exit 0
        fi
        
        # Validate selection
        if validate_selection "$selection"; then
            return 0
        fi
        
        echo
        echo -e "${RED}❌ Invalid selection. Please try again.${NC}"
        echo
    done
}

# Function to get subdirectory (optional)
get_subdirectory() {
    while true; do
        echo
        echo -e "${YELLOW}Subdirectory options:${NC}"
        echo -e "  ${CYAN}Organize environments into subdirectories (e.g., apache, experimental)${NC}"
        echo

        # Build array of existing subdirectories (exclude environment directories and template)
        # Environment directories contain main.tf or .envrc files
        local -a existing_subdirs_array=()
        for dir in "$ENVIRONMENTS_DIR"/*; do
            if [[ -d "$dir" && ! "$dir" == *"/multi-os-sample" ]]; then
                local basename=$(basename "$dir")
                # Skip hidden directories and check if it's NOT an environment
                if [[ ! "$basename" =~ ^\. ]] && \
                   [[ ! -f "$dir/main.tf" ]] && \
                   [[ ! -f "$dir/.envrc" ]]; then
                    # This is a subdirectory container, not an environment
                    existing_subdirs_array+=("$basename")
                fi
            fi
        done

        # Sort the array
        IFS=$'\n' existing_subdirs_array=($(sort <<<"${existing_subdirs_array[*]}"))
        unset IFS

        # Build selection menu
        local option_num=1
        declare -A subdir_map

        # Option 1: No subdirectory (always first)
        echo -e "  ${GREEN}[${option_num}]${NC} No subdirectory ${PURPLE}(default - create in environments/)${NC}"
        subdir_map["$option_num"]=""
        ((option_num++))

        # Options for existing subdirectories
        if [[ ${#existing_subdirs_array[@]} -gt 0 ]]; then
            echo
            echo -e "  ${PURPLE}Existing subdirectories:${NC}"
            for subdir in "${existing_subdirs_array[@]}"; do
                echo -e "  ${GREEN}[${option_num}]${NC} $subdir"
                subdir_map["$option_num"]="$subdir"
                ((option_num++))
            done
        fi

        echo
        # Option for creating new subdirectory
        local new_subdir_option=$option_num
        echo -e "  ${GREEN}[${option_num}]${NC} Create new subdirectory"
        echo -e "  ${GREEN}[b]${NC} Back to OS selection"
        echo -e "  ${GREEN}[q]${NC} Quit"
        echo

        local max_option=$((option_num))
        echo -n -e "${YELLOW}Choose option [1-${max_option}/b/q] (default: 1): ${NC}"
        read -r subdir_choice

        # Default to option 1 if empty
        if [[ -z "$subdir_choice" ]]; then
            subdir_choice="1"
        fi

        # Check for quit option
        if [[ "$subdir_choice" == "q" || "$subdir_choice" == "Q" ]]; then
            echo -e "${YELLOW}👋 Goodbye!${NC}"
            exit 0
        fi

        # Check for back option
        if [[ "$subdir_choice" == "b" || "$subdir_choice" == "B" ]]; then
            return 1  # Signal to go back
        fi

        # Check if it's the "create new" option
        if [[ "$subdir_choice" == "$new_subdir_option" ]]; then
            echo -n -e "${YELLOW}Enter new subdirectory name: ${NC}"
            read -r subdirectory
            if [[ -z "$subdirectory" ]]; then
                echo -e "${RED}❌ Empty subdirectory not allowed${NC}"
                echo
                continue
            fi
            # Validate subdirectory name (basic check)
            if [[ ! "$subdirectory" =~ ^[a-zA-Z0-9_-]+$ ]]; then
                echo -e "${RED}❌ Invalid subdirectory name. Use only letters, numbers, hyphens, and underscores.${NC}"
                echo
                continue
            fi
            SELECTED_SUBDIRECTORY="$subdirectory"
            return 0
        fi

        # Check if it's a valid numeric option (check if key exists in map)
        if [[ "$subdir_choice" =~ ^[0-9]+$ ]] && [[ -v "subdir_map[$subdir_choice]" ]]; then
            SELECTED_SUBDIRECTORY="${subdir_map[$subdir_choice]}"
            return 0
        else
            echo -e "${RED}❌ Invalid option. Please choose 1-${max_option} or b.${NC}"
            echo
        fi
    done
}

# Function to get directory name choice
get_directory_name() {
    local selection=$1
    local subdirectory="$2"
    local actual_key="${SELECTION_MAP[$selection]}"
    local custom_name=""

    while true; do
        echo
        echo -e "${YELLOW}Directory name options:${NC}"
        local full_path="environments/"
        if [[ -n "$subdirectory" ]]; then
            full_path+="${subdirectory}/"
        fi
        echo -e "  ${GREEN}[1]${NC} Use default name: ${CYAN}${full_path}${DIR_NAMES[$actual_key]}${NC} ${PURPLE}(default)${NC}"
        echo -e "  ${GREEN}[2]${NC} Enter custom name"
        echo -e "  ${GREEN}[b]${NC} Back to subdirectory selection"
        echo -e "  ${GREEN}[q]${NC} Quit"
        echo
        echo -n -e "${YELLOW}Choose option [1/2/b/q] (default: 1): ${NC}"
        read -r name_choice

        # Default to option 1 if empty
        if [[ -z "$name_choice" ]]; then
            name_choice="1"
        fi

        case "$name_choice" in
            "q"|"Q")
                echo -e "${YELLOW}👋 Goodbye!${NC}"
                exit 0
                ;;
            "1")
                custom_name=""
                ;;
            "2")
                echo -n -e "${YELLOW}Enter custom directory name: ${NC}"
                read -r custom_name
                if [[ -z "$custom_name" ]]; then
                    echo -e "${RED}❌ Empty name not allowed${NC}"
                    echo
                    continue
                fi
                # Validate directory name (basic check)
                if [[ ! "$custom_name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
                    echo -e "${RED}❌ Invalid directory name. Use only letters, numbers, hyphens, and underscores.${NC}"
                    echo
                    continue
                fi
                ;;
            "b"|"B")
                return 1  # Signal to go back
                ;;
            *)
                echo -e "${RED}❌ Invalid option. Please choose 1, 2, or b.${NC}"
                echo
                continue
                ;;
        esac

        # Show confirmation of what will be created
        local target_name="${custom_name:-${DIR_NAMES[$actual_key]}}"
        local display_path="environments/"
        if [[ -n "$subdirectory" ]]; then
            display_path+="${subdirectory}/"
        fi
        display_path+="$target_name"

        echo
        echo -e "${GREEN}✓${NC} Will create: ${CYAN}$display_path${NC}"

        # Check if directory already exists
        local target_name="${custom_name:-${DIR_NAMES[$actual_key]}}"
        local target_dir="$ENVIRONMENTS_DIR"
        if [[ -n "$subdirectory" ]]; then
            target_dir="$target_dir/$subdirectory"
        fi
        target_dir="$target_dir/$target_name"

        if [[ -d "$target_dir" ]]; then
            echo
            echo -e "${YELLOW}⚠️  Directory already exists: ${target_dir}${NC}"

            # Check for active Terraform state
            local tfstate_file="$target_dir/terraform.tfstate"
            local has_active_resources=false

            if [[ -f "$tfstate_file" ]]; then
                # Check if state file has resources
                if command -v jq &> /dev/null; then
                    local resource_count=$(jq -r '.resources | length' "$tfstate_file" 2>/dev/null || echo "0")
                    if [[ "$resource_count" -gt 0 ]]; then
                        has_active_resources=true
                    fi
                else
                    # Fallback: simple check for "resources" in file
                    if grep -q '"resources"' "$tfstate_file" 2>/dev/null; then
                        has_active_resources=true
                    fi
                fi
            fi

            if [[ "$has_active_resources" == "true" ]]; then
                echo -e "${RED}🚨 BLOCKED: Active Terraform state detected!${NC}"
                echo -e "${RED}This directory contains managed infrastructure resources.${NC}"
                echo
                echo -e "${YELLOW}You MUST do one of the following:${NC}"
                echo -e "${YELLOW}  1. Run 'terraform destroy' in this directory first${NC}"
                echo -e "${YELLOW}  2. Choose a different directory name${NC}"
                echo
                echo -e "${CYAN}To destroy resources:${NC}"
                echo -e "  ${CYAN}cd $target_dir${NC}"
                echo -e "  ${CYAN}terraform destroy${NC}"
                echo
                echo -e "  ${GREEN}[1]${NC} Choose a different name"
                echo -e "  ${GREEN}[b]${NC} Back to subdirectory selection"
                echo -e "  ${GREEN}[q]${NC} Quit"
                echo
                echo -n -e "${YELLOW}Choose option [1/b/q]: ${NC}"
                read -r overwrite_choice

                case "$overwrite_choice" in
                    "q"|"Q")
                        echo -e "${YELLOW}👋 Goodbye!${NC}"
                        exit 0
                        ;;
                    "1")
                        # Loop back to directory name selection
                        continue
                        ;;
                    "b"|"B")
                        return 1  # Signal to go back
                        ;;
                    *)
                        echo -e "${RED}❌ Invalid option. Please choose 1, b, or q.${NC}"
                        echo
                        continue
                        ;;
                esac
            else
                # No active resources - allow overwrite
                echo -e "${YELLOW}This directory will be overwritten if you continue.${NC}"
                echo
                echo -e "  ${GREEN}[1]${NC} Choose a different name ${PURPLE}(recommended)${NC}"
                echo -e "  ${GREEN}[2]${NC} Continue (will overwrite)"
                echo -e "  ${GREEN}[b]${NC} Back to subdirectory selection"
                echo -e "  ${GREEN}[q]${NC} Quit"
                echo
                echo -n -e "${YELLOW}Choose option [1/2/b/q]: ${NC}"
                read -r overwrite_choice

                case "$overwrite_choice" in
                    "q"|"Q")
                        echo -e "${YELLOW}👋 Goodbye!${NC}"
                        exit 0
                        ;;
                    "1")
                        # Loop back to directory name selection
                        continue
                        ;;
                    "2")
                        # Continue with this name (will overwrite)
                        break
                        ;;
                    "b"|"B")
                        return 1  # Signal to go back
                        ;;
                    *)
                        echo -e "${RED}❌ Invalid option. Please choose 1, 2, b, or q.${NC}"
                        echo
                        continue
                        ;;
                esac
            fi
        else
            # Directory doesn't exist, proceed
            break
        fi
    done

    # Return the custom name via a global variable
    SELECTED_CUSTOM_NAME="$custom_name"
    return 0
}

# Function to get database node count (drives vm_count, placement group, and
# whether the Burstable instance-type group is offered).
get_node_count() {
    while true; do
        echo
        echo -e "${YELLOW}Number of Database Nodes:${NC}"
        echo
        echo -e "  ${CYAN}How many database instances to provision (1-16).${NC}"
        echo -e "  ${CYAN}1 node:  no AWS cluster placement group; all instance-type groups available.${NC}"
        echo -e "  ${CYAN}2+ nodes: cluster placement group created; Burstable (t3) types unavailable.${NC}"
        echo
        echo -e "  ${GREEN}[q]${NC} Quit"
        echo
        echo -n -e "${YELLOW}Enter node count [1-16/q] or press Enter for default (1): ${NC}"
        read -r choice

        # Default to a single node on empty Enter
        if [[ -z "$choice" ]]; then
            SELECTED_VM_COUNT=1
            return 0
        fi

        # Check for quit option
        if [[ "$choice" == "q" || "$choice" == "Q" ]]; then
            echo -e "${YELLOW}👋 Goodbye!${NC}"
            exit 0
        fi

        # Validate node count (integer, within range)
        if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > 16 )); then
            echo -e "${RED}❌ Invalid selection. Please enter an integer 1-16 or q.${NC}"
            continue
        fi

        SELECTED_VM_COUNT="$choice"
        return 0
    done
}

# Function to get instance type selection (two-level: group, then type).
# Accepts the chosen node count: when >1 the Burstable group is hidden because
# AWS cluster placement groups reject burstable (t3/t4g) instance types.
# Accepts the OS architecture: arm64 offers the Graviton menu, x86_64 (default)
# offers the Intel menu.
get_instance_type() {
    local vm_count="${1:-1}"
    local arch="${2:-x86_64}"

    # Architecture-specific default type
    local default_type="$DEFAULT_INSTANCE_TYPE"
    if [[ "$arch" == "arm64" ]]; then
        default_type="$DEFAULT_INSTANCE_TYPE_ARM64"
    fi

    # Build the active group list, omitting Burstable for multi-node clusters.
    local -a group_order=()
    local g
    for g in "${INSTANCE_GROUP_ORDER[@]}"; do
        if (( vm_count > 1 )) && [[ "$g" == "Burstable" ]]; then
            continue
        fi
        group_order+=("$g")
    done
    local num_groups=${#group_order[@]}

    # Group-selection loop
    while true; do
        echo
        echo -e "${YELLOW}Select Instance Type:${NC} ${PURPLE}(architecture: ${arch})${NC}"
        echo
        echo -e "${CYAN}Instance Type Groups:${NC}"
        echo
        local gi
        for ((gi = 0; gi < num_groups; gi++)); do
            local group="${group_order[$gi]}"
            local caveat="${INSTANCE_GROUP_CAVEATS[$group]:-}"
            if [[ -n "$caveat" ]]; then
                echo -e "  ${GREEN}[$((gi + 1))]${NC} ${group} ${PURPLE}(${caveat})${NC}"
            else
                echo -e "  ${GREEN}[$((gi + 1))]${NC} ${group}"
            fi
        done
        echo
        echo -e "  ${GREEN}[q]${NC} Quit"
        echo
        echo -n -e "${YELLOW}Select group [1-${num_groups}/q] or press Enter for default (${default_type}): ${NC}"
        read -r group_choice

        # Default: Enter selects Compute Optimized and its default type
        if [[ -z "$group_choice" ]]; then
            SELECTED_INSTANCE_TYPE="$default_type"
            return 0
        fi

        # Check for quit option
        if [[ "$group_choice" == "q" || "$group_choice" == "Q" ]]; then
            echo -e "${YELLOW}👋 Goodbye!${NC}"
            exit 0
        fi

        # Validate group choice (numeric, within range)
        if ! [[ "$group_choice" =~ ^[0-9]+$ ]] || (( group_choice < 1 || group_choice > num_groups )); then
            echo -e "${RED}❌ Invalid selection. Please choose 1-${num_groups} or q.${NC}"
            echo
            continue
        fi

        local group="${group_order[$((group_choice - 1))]}"
        local -a types=()
        if [[ "$arch" == "arm64" ]]; then
            read -r -a types <<< "${ARM64_INSTANCE_GROUP_TYPES[$group]}"
        else
            read -r -a types <<< "${INSTANCE_GROUP_TYPES[$group]}"
        fi
        local num_types=${#types[@]}

        # Type-selection loop for the chosen group
        while true; do
            echo
            echo -e "${CYAN}${group} Instances:${NC}"
            local caveat="${INSTANCE_GROUP_CAVEATS[$group]:-}"
            if [[ -n "$caveat" ]]; then
                echo -e "  ${PURPLE}${caveat}${NC}"
            fi
            echo
            local ti
            for ((ti = 0; ti < num_types; ti++)); do
                local type="${types[$ti]}"
                local spec="${INSTANCE_TYPE_SPECS[$type]:-}"
                local idx
                idx=$(printf '%2d' "$((ti + 1))")
                local padded
                padded=$(printf '%-12s' "$type")
                if [[ "$type" == "$default_type" ]]; then
                    echo -e "    ${GREEN}[${idx}]${NC} ${padded} (${spec}) ${PURPLE}[default]${NC}"
                else
                    echo -e "    ${GREEN}[${idx}]${NC} ${padded} (${spec})"
                fi
            done
            echo
            echo -e "  ${GREEN}[b]${NC} Back to groups"
            echo -e "  ${GREEN}[q]${NC} Quit"
            echo
            echo -n -e "${YELLOW}Select instance type [1-${num_types}/b/q]: ${NC}"
            read -r type_choice

            # Check for quit option
            if [[ "$type_choice" == "q" || "$type_choice" == "Q" ]]; then
                echo -e "${YELLOW}👋 Goodbye!${NC}"
                exit 0
            fi

            # Back to the group list
            if [[ "$type_choice" == "b" || "$type_choice" == "B" ]]; then
                break
            fi

            # Validate type choice (numeric, within range)
            if ! [[ "$type_choice" =~ ^[0-9]+$ ]] || (( type_choice < 1 || type_choice > num_types )); then
                echo -e "${RED}❌ Invalid selection. Please choose 1-${num_types}, b, or q.${NC}"
                continue
            fi

            SELECTED_INSTANCE_TYPE="${types[$((type_choice - 1))]}"
            return 0
        done
    done
}

# Function to get spot instance preference
get_spot_instances() {
    while true; do
        echo
        echo -e "${YELLOW}Enable Spot Instances?${NC}"
        echo
        echo -e "  ${CYAN}Spot instances can save up to 90% on EC2 costs but may be interrupted.${NC}"
        echo
        echo -e "  ${GREEN}[1]${NC} No - Use On-Demand instances ${PURPLE}(default, more reliable)${NC}"
        echo -e "  ${GREEN}[2]${NC} Yes - Use Spot instances ${PURPLE}(cheaper, may be interrupted)${NC}"
        echo -e "  ${GREEN}[q]${NC} Quit"
        echo
        echo -n -e "${YELLOW}Select option [1/2/q] or press Enter for default (On-Demand): ${NC}"
        read -r choice

        # Default to false (on-demand) if empty
        if [[ -z "$choice" ]]; then
            choice="1"
        fi

        case "$choice" in
            "q"|"Q")
                echo -e "${YELLOW}👋 Goodbye!${NC}"
                exit 0
                ;;
            "1")
                SELECTED_USE_SPOT="false"
                return 0
                ;;
            "2")
                SELECTED_USE_SPOT="true"
                return 0
                ;;
            *)
                echo -e "${RED}❌ Invalid selection. Please choose 1, 2, or q.${NC}"
                echo
                ;;
        esac
    done
}

# Function to get DBaaS platform deployment preference
get_dbaas_platform() {
    while true; do
        echo
        echo -e "${YELLOW}Deploy DBaaS Platform Infrastructure?${NC}"
        echo
        echo -e "  ${CYAN}DBaaS platform includes EKS cluster, S3 storage, and networking for Kubernetes-based services.${NC}"
        echo -e "  ${CYAN}This enables database-as-a-service application deployment alongside your database cluster.${NC}"
        echo
        echo -e "  ${GREEN}[1]${NC} No - Database cluster only ${PURPLE}(default, lower cost)${NC}"
        echo -e "  ${GREEN}[2]${NC} Yes - Deploy full DBaaS platform ${PURPLE}(EKS + S3 + ~\$250/month)${NC}"
        echo -e "  ${GREEN}[q]${NC} Quit"
        echo
        echo -n -e "${YELLOW}Select option [1/2/q] or press Enter for default (No): ${NC}"
        read -r choice

        # Default to false (no dbaas) if empty
        if [[ -z "$choice" ]]; then
            choice="1"
        fi

        case "$choice" in
            "q"|"Q")
                echo -e "${YELLOW}👋 Goodbye!${NC}"
                exit 0
                ;;
            "1")
                SELECTED_DEPLOY_DBAAS="false"
                return 0
                ;;
            "2")
                SELECTED_DEPLOY_DBAAS="true"
                return 0
                ;;
            *)
                echo -e "${RED}❌ Invalid selection. Please choose 1, 2, or q.${NC}"
                echo
                ;;
        esac
    done
}

# Function to confirm environment creation
confirm_creation() {
    local selection=$1
    local custom_name="$2"
    local instance_type="$3"
    local use_spot="$4"
    local deploy_dbaas="$5"
    local subdirectory="$6"
    local vm_count="$7"
    local actual_key="${SELECTION_MAP[$selection]}"
    local os_name="${OS_OPTIONS[$actual_key]}"
    local dir_name="${custom_name:-${DIR_NAMES[$actual_key]}}"

    # Build full path for display
    local full_path="environments/"
    if [[ -n "$subdirectory" ]]; then
        full_path+="${subdirectory}/"
    fi
    full_path+="$dir_name"

    # Build AWS environment prefix (what resources will be named)
    local env_prefix="${USER}"
    if [[ -n "$subdirectory" ]]; then
        env_prefix+="-${subdirectory}"
    fi
    env_prefix+="-${dir_name}"

    while true; do
        echo
        echo -e "${CYAN}📋 Summary:${NC}"
        echo -e "  ${PURPLE}OS:${NC} $os_name"
        echo -e "  ${PURPLE}Path:${NC} $full_path"
        echo -e "  ${PURPLE}AWS Prefix:${NC} $env_prefix"
        echo -e "  ${PURPLE}AMI Owner:${NC} ${AMI_OWNERS[$actual_key]}"
        echo -e "  ${PURPLE}AMI Filter:${NC} ${AMI_FILTERS[$actual_key]}"
        echo -e "  ${PURPLE}Username:${NC} ${DEFAULT_USERNAMES[$actual_key]}"
        echo -e "  ${PURPLE}Database Nodes:${NC} $vm_count $([ "$vm_count" -gt 1 ] && echo "(cluster placement group)" || echo "(no placement group)")"
        echo -e "  ${PURPLE}Architecture:${NC} ${OS_ARCHES[$actual_key]:-x86_64}"
        echo -e "  ${PURPLE}Instance Type:${NC} $instance_type"
        echo -e "  ${PURPLE}Spot Instances:${NC} $([ "$use_spot" = "true" ] && echo "✓ Enabled" || echo "✗ Disabled")"
        echo -e "  ${PURPLE}DBaaS Platform:${NC} $([ "$deploy_dbaas" = "true" ] && echo "✓ Enabled (EKS + S3)" || echo "✗ Disabled")"
        echo
        echo -e "${YELLOW}Actions:${NC}"
        echo -e "  ${GREEN}[c]${NC} Create environment ${PURPLE}(default)${NC}"
        echo -e "  ${GREEN}[b]${NC} Reconfigure (from node count)"
        echo -e "  ${GREEN}[o]${NC} Back to OS selection"
        echo -e "  ${GREEN}[q]${NC} Quit"
        echo
        echo -n -e "${YELLOW}Choose action [c/b/o/q] (default: c): ${NC}"
        read -r action

        # Default to create if empty
        if [[ -z "$action" ]]; then
            action="c"
        fi

        case "$action" in
            "c"|"C")
                return 0  # Proceed with creation
                ;;
            "b"|"B")
                return 1  # Go back to instance configuration
                ;;
            "o"|"O")
                return 2  # Go back to OS selection
                ;;
            "q"|"Q")
                echo -e "${YELLOW}👋 Goodbye!${NC}"
                exit 0
                ;;
            *)
                echo -e "${RED}❌ Invalid option. Please choose c, b, o, or q.${NC}"
                echo
                ;;
        esac
    done
}

# Main function with navigation flow
main() {
    clear
    check_template
    show_header

    while true; do
        # Step 1: Get OS selection
        get_os_selection
        local selection=$selection

        while true; do
            # Show configuration for selected OS
            show_configuration "$selection"

            # Step 2: Get subdirectory (optional)
            if get_subdirectory; then
                local subdirectory="$SELECTED_SUBDIRECTORY"

                while true; do
                    # Step 3: Get directory name
                    if get_directory_name "$selection" "$subdirectory"; then
                        local custom_name="$SELECTED_CUSTOM_NAME"

                        while true; do
                            # Step 4: Get database node count
                            get_node_count
                            local vm_count="$SELECTED_VM_COUNT"

                            # Step 5: Get instance type (Burstable hidden when
                            # vm_count > 1; menu follows the OS architecture)
                            local os_arch="${OS_ARCHES[${SELECTION_MAP[$selection]}]:-x86_64}"
                            get_instance_type "$vm_count" "$os_arch"
                            local instance_type="$SELECTED_INSTANCE_TYPE"

                            # Step 6: Get spot instance preference
                            get_spot_instances
                            local use_spot="$SELECTED_USE_SPOT"

                            # Step 7: Get DBaaS platform preference
                            get_dbaas_platform
                            local deploy_dbaas="$SELECTED_DEPLOY_DBAAS"

                            # Step 8: Confirm and create
                            local confirm_result
                            set +e  # Temporarily disable exit on error to capture return code
                            confirm_creation "$selection" "$custom_name" "$instance_type" "$use_spot" "$deploy_dbaas" "$subdirectory" "$vm_count"
                            confirm_result=$?
                            set -e  # Re-enable exit on error

                            case $confirm_result in
                                0)
                                    # Create environment and exit
                                    create_environment "$selection" "$custom_name" "$instance_type" "$use_spot" "$deploy_dbaas" "$subdirectory" "$vm_count"
                                    exit 0
                                    ;;
                                1)
                                    # Go back to instance configuration - continue inner loop
                                    continue
                                    ;;
                                2)
                                    # Go back to OS selection - break all inner loops
                                    break 3
                                    ;;
                            esac
                        done
                    else
                        # User chose to go back to subdirectory selection
                        break
                    fi
                done
            else
                # User chose to go back to OS selection
                break
            fi
        done
    done
}

# Run main function
main "$@"
