    ["t4g.nano"]="2 vCPU, 0.5 GB"
    ["t4g.micro"]="2 vCPU, 1 GB"
    ["t4g.small"]="2 vCPU, 2 GB"
    ["t4g.medium"]="2 vCPU, 4 GB"
