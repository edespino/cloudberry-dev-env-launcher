declare -A OS_GROUPS
declare -A AMI_OWNERS
declare -A AMI_FILTERS
declare -A DEFAULT_USERNAMES
declare -A DIR_NAMES
declare -A OS_ARCHES
declare -A SELECTION_MAP

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

