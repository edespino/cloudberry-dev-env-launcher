alias ti='terraform init'      # Local backend (uses backend.tf config)
EOF

    # No need to modify main.tf - template now uses generic names

    # Handle DBaaS-specific files if deploying DBaaS services
    if [[ "$deploy_dbaas" == "true" ]]; then
        echo -e "${BLUE}🚀 Setting up DBaaS platform files...${NC}"

        # Copy terraform.tfvars template
        if [[ -f "$TEMPLATE_DIR/terraform.tfvars.dbaas-template" ]]; then
