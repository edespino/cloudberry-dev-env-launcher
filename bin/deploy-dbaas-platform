#!/bin/bash
# DBaaS Platform Deployment Script
# Usage: ./deploy.sh <command>
#
# Commands:
#   infra          - Deploy infrastructure with Terraform
#   helm           - Deploy Helm charts on remote VM
#   wait-alb       - Wait for ALB to be provisioned
#   dns            - Create DNS record via Terraform
#   verify         - Verify complete deployment
#   all            - Run all steps in sequence
#   teardown       - Destroy all infrastructure
#   help           - Show this help message

set -e

# Source environment functions
if [ -f .env ]; then
  source .env
fi

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Configuration from environment
EKS_CLUSTER_NAME="${TF_VAR_env_prefix}-dbaas-cluster"
AWS_REGION="${TF_VAR_region:-us-west-2}"
SSH_KEY="${TF_VAR_env_prefix}_generated_key.pem"
SSH_USER="${TF_VAR_default_username:-rocky}"
DOMAIN_NAME="${TF_VAR_dbaas_domain_name:-synxdb-elastic-demo.synxdata.us}"

# ============================================================================
# Helper Functions
# ============================================================================

show_help() {
  echo -e "${BLUE}DBaaS Platform Deployment Script${NC}"
  echo ""
  echo "Usage: $0 <command>"
  echo ""
  echo "Commands:"
  printf "  %-12s - %s\n" "infra" "Deploy infrastructure with Terraform (Step 1)"
  printf "  %-12s - %s\n" "helm" "Deploy Helm charts on remote VM (Step 2)"
  printf "  %-12s - %s\n" "wait-alb" "Wait for ALB to be provisioned (Step 3)"
  printf "  %-12s - %s\n" "dns" "Create DNS record via Terraform (Step 4)"
  printf "  %-12s - %s\n" "verify" "Verify complete deployment (Step 5)"
  printf "  %-12s - %s\n" "all" "Run all steps in sequence"
  printf "  %-12s - %s\n" "teardown" "Destroy all infrastructure"
  printf "  %-12s - %s\n" "help" "Show this help message"
  echo ""
  echo "Examples:"
  echo "  $0 all           # Full deployment"
  echo "  $0 infra         # Just deploy infra"
  echo "  $0 helm          # Just deploy helm charts"
  echo "  $0 teardown      # Destroy everything"
  echo ""
  echo "Environment Variables (from .envrc):"
  echo "  TF_VAR_cloudflare_api_token  - Cloudflare API token (required for DNS)"
  echo "  TF_VAR_default_username      - SSH username (current: $SSH_USER)"
  echo "  TF_VAR_env_prefix           - Environment prefix"
  echo "  TF_VAR_region               - AWS region (current: $AWS_REGION)"
  echo ""
}

# ============================================================================
# Step 1: Deploy Infrastructure
# ============================================================================

cmd_infra() {
  echo -e "${BLUE}========================================"
  echo "📦 Step 1: Deploy Infrastructure"
  echo -e "========================================${NC}"
  echo ""

  if [ -z "$TF_VAR_cloudflare_api_token" ]; then
    echo -e "${YELLOW}⚠️  TF_VAR_cloudflare_api_token not set${NC}"
    echo "DNS creation in step 4 will require this"
    echo ""
  fi

  echo "Deploying with Terraform..."
  terraform apply

  echo ""
  echo -e "${GREEN}✅ Infrastructure deployed${NC}"
  echo ""

  # Get and show VM IP using the function
  if type get_instance_ip &>/dev/null; then
    VM_IP=$(get_instance_ip 0)
    echo "VM IP: $VM_IP"
  fi

  echo "EKS Cluster: $EKS_CLUSTER_NAME"
  echo ""
  echo -e "${BLUE}Next: $0 helm${NC}"
}

# Alias for backwards compatibility
cmd_infrastructure() {
  cmd_infra
}

# ============================================================================
# Step 2: Deploy Helm Charts
# ============================================================================

cmd_helm() {
  echo -e "${BLUE}========================================"
  echo "🚀 Step 2: Deploy Helm Charts"
  echo -e "========================================${NC}"
  echo ""

  # Get VM IP using the function
  if ! type get_instance_ip &>/dev/null; then
    echo -e "${RED}❌ get_instance_ip function not available${NC}"
    echo "Make sure .env is sourced or run: source .env"
    exit 1
  fi

  VM_IP=$(get_instance_ip 0)

  if [ -z "$VM_IP" ] || [ "$VM_IP" = "None" ]; then
    echo -e "${RED}❌ Could not get VM IP${NC}"
    echo "Run: $0 infrastructure first"
    exit 1
  fi

  echo "Target VM: $VM_IP"
  echo "SSH User: $SSH_USER"
  echo "SSH Key: $SSH_KEY"
  echo ""

  if [ ! -f "$SSH_KEY" ]; then
    echo -e "${RED}❌ SSH key not found: $SSH_KEY${NC}"
    exit 1
  fi

  echo "Connecting to VM and deploying helm charts..."
  echo ""

  ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no "$SSH_USER@$VM_IP" << 'ENDSSH'
set -e

echo "📍 Connected to VM: $(hostname)"
echo ""

# Find helm charts directory
if [ -d ~/example ]; then
  cd ~/example
elif [ -d /opt/app/example ]; then
  cd /opt/app/example
elif [ -d /home/rocky/example ]; then
  cd /home/rocky/example
else
  echo "❌ Could not find helm charts directory"
  echo "Available directories:"
  ls -la ~/
  exit 1
fi

echo "📦 Helm charts directory: $(pwd)"
echo ""

# Deploy FDB Operator
echo "=== Deploying FDB Operator ==="
helm install fdb-operator ../helm/fdb-operator-0.2.0.tgz \
  --namespace fdb \
  --timeout 30m \
  --wait \
  --create-namespace \
  -f foundationdb-values.yaml
echo "✅ FDB Operator deployed"
echo ""

# Deploy CloudBeaver
echo "=== Deploying CloudBeaver ==="
helm install cloudbeaver ../helm/cloudbeaver-0.1.0.tgz \
  --namespace cloudbeaver \
  --timeout 10m \
  --wait \
  --create-namespace \
  -f cloudbeaver-values.yaml
echo "✅ CloudBeaver deployed"
echo ""

# Deploy DBaaS Integration
echo "=== Deploying DBaaS Integration ==="
helm install dbaas-integration ../helm/synxdb-dbaas-integration-1.1.0.tgz \
  --namespace dbaas \
  --timeout 10m \
  --wait \
  --create-namespace \
  -f dbaas-values.yaml
echo "✅ DBaaS Integration deployed"
echo ""

echo "All helm releases:"
helm list -A

ENDSSH

  if [ $? -eq 0 ]; then
    echo ""
    echo -e "${GREEN}✅ Helm charts deployed successfully${NC}"
    echo ""
    echo "Verify with: kubectl get pods -n dbaas"
    echo ""
    echo -e "${BLUE}Next: $0 wait-alb${NC}"
  else
    echo -e "${RED}❌ Helm deployment failed${NC}"
    exit 1
  fi
}

# ============================================================================
# Step 3: Wait for ALB
# ============================================================================

cmd_wait_alb() {
  echo -e "${BLUE}========================================"
  echo "⏳ Step 3: Wait for ALB Provisioning"
  echo -e "========================================${NC}"
  echo ""

  # Verify prerequisites
  echo "Checking dbaas-integration service..."
  kubectl get svc dbaas-integration -n dbaas > /dev/null 2>&1 || {
    echo -e "${RED}❌ Service not found${NC}"
    echo "Run: $0 helm first"
    exit 1
  }

  ENDPOINTS=$(kubectl get endpoints dbaas-integration -n dbaas -o jsonpath='{.subsets[0].addresses[0].ip}' 2>/dev/null || echo "")
  if [ -z "$ENDPOINTS" ]; then
    echo -e "${RED}❌ No service endpoints - pods not ready${NC}"
    echo "Check: kubectl get pods -n dbaas"
    exit 1
  fi

  echo -e "${GREEN}✅ Service has endpoints: $ENDPOINTS${NC}"
  echo ""

  # Wait for ALB
  echo "Waiting for ALB (typically 2-3 minutes)..."
  kubectl wait --for=jsonpath='{.status.loadBalancer.ingress[0].hostname}' \
    ingress/dbaas-ui-ingress -n dbaas --timeout=5m

  ALB_HOSTNAME=$(kubectl get ingress dbaas-ui-ingress -n dbaas -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')
  echo ""
  echo -e "${GREEN}✅ ALB provisioned: $ALB_HOSTNAME${NC}"
  echo ""

  # Check target health
  echo "Checking target health..."

  # Get load balancer ARN from the ALB hostname
  ALB_ARN=$(aws elbv2 describe-load-balancers --region $AWS_REGION \
    --query "LoadBalancers[?DNSName=='$ALB_HOSTNAME'].LoadBalancerArn" \
    --output text 2>/dev/null || echo "")

  if [ -z "$ALB_ARN" ]; then
    echo -e "${YELLOW}⚠️  Could not find ALB ARN, skipping health check${NC}"
  else
    # Get target groups for this specific ALB
    TG_ARNS=$(aws elbv2 describe-target-groups --region $AWS_REGION \
      --load-balancer-arn "$ALB_ARN" \
      --query 'TargetGroups[*].TargetGroupArn' \
      --output text 2>/dev/null || echo "")

    if [ -n "$TG_ARNS" ]; then
      # Check health of first target group (there should only be one for our ingress)
      TG_ARN=$(echo "$TG_ARNS" | awk '{print $1}')

      for i in {1..60}; do
        HEALTH=$(aws elbv2 describe-target-health \
          --target-group-arn "$TG_ARN" \
          --region $AWS_REGION \
          --query 'TargetHealthDescriptions[0].TargetHealth.State' \
          --output text 2>/dev/null || echo "unknown")

        if [ "$HEALTH" = "healthy" ]; then
          echo -e "${GREEN}✅ Targets are healthy${NC}"
          break
        fi

        echo "  Target health: $HEALTH (attempt $i/60)"
        sleep 5

        if [ $i -eq 60 ]; then
          echo -e "${YELLOW}⚠️  Timeout waiting for healthy targets${NC}"
          break
        fi
      done
    else
      echo -e "${YELLOW}⚠️  Target groups not found yet${NC}"
    fi
  fi

  echo ""
  echo -e "${GREEN}✅ ALB is ready${NC}"
  echo ""
  echo -e "${BLUE}Next: $0 dns${NC}"
}

# ============================================================================
# Step 4: Create DNS
# ============================================================================

cmd_dns() {
  echo -e "${BLUE}========================================"
  echo "🌐 Step 4: Create DNS Record"
  echo -e "========================================${NC}"
  echo ""

  if [ -z "$TF_VAR_cloudflare_api_token" ]; then
    echo -e "${RED}❌ TF_VAR_cloudflare_api_token not set${NC}"
    echo "Set it with: export TF_VAR_cloudflare_api_token=\"your-token\""
    exit 1
  fi

  # Verify ALB exists
  ALB_HOSTNAME=$(kubectl get ingress dbaas-ui-ingress -n dbaas -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || echo "")
  if [ -z "$ALB_HOSTNAME" ]; then
    echo -e "${RED}❌ ALB not provisioned${NC}"
    echo "Run: $0 wait-alb first"
    exit 1
  fi

  echo "ALB: $ALB_HOSTNAME"
  echo "Domain: $DOMAIN_NAME"
  echo ""
  echo "Creating DNS record via Terraform..."

  terraform apply \
    -replace='module.dbaas_platform[0].null_resource.cloudflare_dns_record[0]' \
    -auto-approve

  echo ""
  echo -e "${GREEN}✅ DNS record created${NC}"
  echo ""

  echo "Waiting for DNS propagation..."
  sleep 10

  RESOLVED=$(dig +short $DOMAIN_NAME 2>/dev/null | head -1)
  if [ -n "$RESOLVED" ]; then
    echo -e "${GREEN}✅ DNS resolves to: $RESOLVED${NC}"
  else
    echo -e "${YELLOW}⚠️  DNS propagating (may take 1-5 minutes)${NC}"
  fi

  echo ""
  echo -e "${BLUE}Next: $0 verify${NC}"
}

# ============================================================================
# Step 5: Verify
# ============================================================================

cmd_verify() {
  echo -e "${BLUE}========================================"
  echo "✅ Step 5: Verify Deployment"
  echo -e "========================================${NC}"
  echo ""

  # DNS
  echo "=== DNS Resolution ==="
  RESOLVED=$(dig +short $DOMAIN_NAME 2>/dev/null)
  if [ -n "$RESOLVED" ]; then
    echo -e "${GREEN}✅ DNS resolves${NC}"
    echo "$RESOLVED" | while read line; do echo "  $line"; done
  else
    echo -e "${RED}❌ DNS not resolving${NC}"
  fi
  echo ""

  # HTTP
  echo "=== HTTP Connectivity ==="
  for path in /ops/ /console/ /actuator/health; do
    URL="http://$DOMAIN_NAME$path"
    HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" $URL --max-time 10 2>/dev/null || echo "000")

    if [ "$HTTP_CODE" = "200" ] || [ "$HTTP_CODE" = "302" ]; then
      echo -e "  ${GREEN}✅${NC} $URL (${HTTP_CODE})"
    else
      echo -e "  ${RED}❌${NC} $URL (${HTTP_CODE})"
    fi
  done
  echo ""

  # Kubernetes
  echo "=== Kubernetes Status ==="
  echo "DBaaS pods:"
  kubectl get pods -n dbaas --no-headers | awk '{print "  "$1" "$3}'
  echo ""

  # Summary
  echo -e "${GREEN}========================================"
  echo "🎉 Deployment Complete!"
  echo -e "========================================${NC}"
  echo ""
  echo "Access URLs:"
  echo "  • Operations Dashboard: http://$DOMAIN_NAME/ops/"
  echo "  • User Console: http://$DOMAIN_NAME/console/"
  echo ""
  echo "Teardown: $0 teardown"
  echo ""
}

# ============================================================================
# Run All Steps
# ============================================================================

cmd_all() {
  echo -e "${BLUE}========================================"
  echo "🚀 Full Deployment"
  echo -e "========================================${NC}"
  echo ""

  cmd_infra
  echo "" && sleep 2

  cmd_helm
  echo "" && sleep 2

  cmd_wait_alb
  echo "" && sleep 2

  cmd_dns
  echo "" && sleep 2

  cmd_verify
}

# ============================================================================
# Teardown
# ============================================================================

cmd_teardown() {
  echo -e "${RED}========================================"
  echo "🗑️  Teardown Infrastructure"
  echo -e "========================================${NC}"
  echo ""

  echo -e "${YELLOW}This will destroy ALL resources including:${NC}"
  echo "  • Cloudflare DNS record"
  echo "  • Application Load Balancer"
  echo "  • EKS Cluster (and all helm releases)"
  echo "  • RDS Database"
  echo "  • S3 Buckets"
  echo "  • EC2 VM instance"
  echo ""
  echo -e "${RED}This action cannot be undone!${NC}"
  echo ""

  read -p "Type 'yes' to confirm: " -r
  echo

  if [ "$REPLY" != "yes" ]; then
    echo "Teardown cancelled"
    exit 0
  fi

  # Pre-cleanup: Delete Kubernetes ingress to trigger ALB cleanup
  echo ""
  echo -e "${BLUE}=== Pre-cleanup: Removing Kubernetes Ingress ===${NC}"

  if command -v kubectl &> /dev/null; then
    # Check if ingress exists
    if kubectl get ingress dbaas-ui-ingress -n dbaas &> /dev/null; then
      echo "Deleting ingress resource (this triggers ALB Controller cleanup)..."
      kubectl delete ingress dbaas-ui-ingress -n dbaas --timeout=60s || true

      echo "Waiting for ALB to be deleted (this may take 2-3 minutes)..."

      # Wait for ALB to be deleted
      ALB_NAME="k8s-dbaas-dbaasuii"
      for i in {1..60}; do
        ALB_EXISTS=$(aws elbv2 describe-load-balancers --region $AWS_REGION \
          --query "LoadBalancers[?contains(LoadBalancerName, '$ALB_NAME')].[LoadBalancerName]" \
          --output text 2>/dev/null || echo "")

        if [ -z "$ALB_EXISTS" ]; then
          echo -e "${GREEN}✅ ALB deleted${NC}"
          break
        fi

        if [ $i -eq 60 ]; then
          echo -e "${YELLOW}⚠️  ALB still exists after 5 minutes. Terraform will handle cleanup.${NC}"
          break
        fi

        if [ $((i % 12)) -eq 0 ]; then
          echo "  Still waiting for ALB deletion... ($i/60)"
        fi
        sleep 5
      done

      # Give a few extra seconds for security groups to be cleaned up
      echo "Waiting for security groups to be cleaned up..."
      sleep 10

    else
      echo "Ingress resource not found (already deleted or cluster not accessible)"
    fi
  else
    echo -e "${YELLOW}⚠️  kubectl not available - skipping pre-cleanup${NC}"
    echo "   Terraform will attempt to clean up, but may encounter delays"
  fi

  # Main terraform destroy
  echo ""
  echo -e "${BLUE}=== Destroying Infrastructure with Terraform ===${NC}"
  terraform destroy -auto-approve

  echo ""
  echo -e "${GREEN}✅ Teardown complete${NC}"
  echo ""
}

# ============================================================================
# Main
# ============================================================================

COMMAND="${1:-help}"

case "$COMMAND" in
  infra|infrastructure)
    cmd_infra
    ;;
  helm)
    cmd_helm
    ;;
  wait-alb)
    cmd_wait_alb
    ;;
  dns)
    cmd_dns
    ;;
  verify)
    cmd_verify
    ;;
  all)
    cmd_all
    ;;
  teardown)
    cmd_teardown
    ;;
  help|--help|-h)
    show_help
    ;;
  *)
    echo -e "${RED}Unknown command: $COMMAND${NC}"
    echo ""
    show_help
    exit 1
    ;;
esac
