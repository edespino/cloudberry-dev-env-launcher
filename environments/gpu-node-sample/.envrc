# Environment configuration for __ENV_PATH__ using gpu-node module
# Sidecar of __PARENT_ENV_DIR__: attaches one GPU instance to that environment's
# VPC, subnet, security group, and SSH key pair. Nothing in the parent is modified.
# This file is automatically sourced when entering the directory (requires direnv).
# Shell aliases (lw, lssh, istate, lpair, ...) live in .env, loaded by the zsh dotenv hook.
# In vpc+laptop mode this file also exports OLLAMA_HOST=http://<node-public-ip>:11434 while the
# node is running, so the ollama CLI and SDKs on this machine talk to the L4 directly.

# Parent environment (relative to this directory). Must already be applied.
PARENT_ENV_DIR="__PARENT_ENV_DIR__"

# GPU node configuration
export TF_VAR_node_name="__NODE_NAME__"
export TF_VAR_instance_type="__INSTANCE_TYPE__"  # g6.2xlarge (default) or g6.xlarge
export TF_VAR_hostname="__HOSTNAME__"
export TF_VAR_root_volume_size=200               # GiB, gp3; minimum 100 (model weights; image ~15 GiB)

# Pinned private IPv4 inside the parent subnet (empty = DHCP, changes on rebuild).
# A pinned address survives rebuilds, so cdw's /etc/hosts, SSH config, and the
# Ollama URL stay valid. Not the first four or the last address (AWS-reserved).
export GPU_PRIVATE_IP="__PRIVATE_IP__"
if [ -n "$GPU_PRIVATE_IP" ]; then export TF_VAR_private_ip="$GPU_PRIVATE_IP"; fi

# Public keys to trust from first boot (one OpenSSH public key per line). The
# `lpair` alias fills this file with the parent host's key; commit nothing here.
export PAIRED_KEYS_FILE="$PWD/paired_keys.pub"
if [ -s "$PAIRED_KEYS_FILE" ]; then
  export TF_VAR_authorized_ssh_public_keys=$(jq -R -s -c 'split("\n") | map(select(length > 0 and (startswith("#") | not)))' "$PAIRED_KEYS_FILE")
else
  export TF_VAR_authorized_ssh_public_keys='[]'
fi

# Ollama exposure (Ollama has no authentication; keep this as narrow as the use needs)
#   tunnel      Ollama on 127.0.0.1 only; laptop and cdw use ssh -L 11434:127.0.0.1:11434 by hand
#   vpc         Ollama on 0.0.0.0; cdw and other 10.0.0.0/16 hosts use http://<private-ip>:11434
#               (parent SG already allows all TCP inside the VPC; no SG change)
#   vpc+laptop  vpc, plus a sidecar-owned SG allowing 11434 from this laptop's current /32.
#               OLLAMA_HOST is exported here while the node runs. A laptop IP change breaks
#               it until `terraform plan` + apply in this directory updates the SG rule (the
#               banner warns; the parent is untouched).
export OLLAMA_ACCESS="__OLLAMA_ACCESS__"
case "$OLLAMA_ACCESS" in
  tunnel)
    export TF_VAR_ollama_bind="loopback"
    export TF_VAR_ollama_client_cidrs='[]'
    ;;
  vpc)
    export TF_VAR_ollama_bind="all"
    export TF_VAR_ollama_client_cidrs='[]'
    ;;
  vpc+laptop)
    export TF_VAR_ollama_bind="all"
    export TF_VAR_my_ip=$(curl -s https://api.ipify.org)
    export TF_VAR_ollama_client_cidrs="[\"${TF_VAR_my_ip}/32\"]"
    ;;
  *)
    echo "Error: OLLAMA_ACCESS must be tunnel, vpc, or vpc+laptop (got '$OLLAMA_ACCESS')"
    return 1
    ;;
esac

## ======================================================================
# AMI configuration (x86_64 only - the g6 family has no arm64 variant)
## ----------------------------------------------------------------------

## __AMI_NAME__
AMI_OWNER="__AMI_OWNER__"
AMI_FILTER='__AMI_FILTER__'
# name:       newest AMI whose name matches AMI_FILTER
# passed-tag: newest AMI whose Name TAG matches "${AMI_FILTER}-PASSED" (image-factory
#             builds record PASSED/FAILED on the Name tag; never pick a failed build)
AMI_MATCH="__AMI_MATCH__"
export TF_VAR_default_username="__DEFAULT_USERNAME__"

## ======================================================================

# AWS SSO profile
export SSO_PROFILE="__SSO_PROFILE__"

## ======================================================================
## NO need to edit below values
## ======================================================================

export TF_VAR_region=__REGION__

if ! aws configure export-credentials --profile $SSO_PROFILE &>/dev/null; then
 echo "Warning: AWS credentials expired. Run: aws sso login --sso-session $SSO_PROFILE "
 return 1
fi

# AWS credentials
credentials=$(aws configure export-credentials --profile $SSO_PROFILE)
export AWS_ACCESS_KEY_ID=$(echo "$credentials" | jq -r '.AccessKeyId')
export AWS_SECRET_ACCESS_KEY=$(echo "$credentials" | jq -r '.SecretAccessKey')
export AWS_SESSION_TOKEN=$(echo "$credentials" | jq -r '.SessionToken')

# Parent environment lookups. Reads specific fields of the parent's local state
# only: the ssh_key output (encodes the prefix) and the subnet ID (plan guard).
PARENT_STATE="$PARENT_ENV_DIR/terraform.tfstate"
if [ ! -f "$PARENT_STATE" ]; then
  echo "Error: parent state not found: $PARENT_STATE"
  echo "  The parent environment must be applied before a GPU node can attach to it."
  return 1
fi
export TF_VAR_parent_prefix=$(jq -r '.outputs.ssh_key.value // empty | sub("_generated_key\\.pem$"; "")' "$PARENT_STATE")
export TF_VAR_parent_subnet_id=$(jq -r '[.resources[] | select(.module=="module.database_cluster" and .type=="aws_subnet")][0].instances[0].attributes.id // empty' "$PARENT_STATE")
if [ -z "$TF_VAR_parent_prefix" ] || [ -z "$TF_VAR_parent_subnet_id" ]; then
  echo "Error: could not derive parent prefix and subnet from $PARENT_STATE"
  return 1
fi
export SSH_KEY_PATH="$PARENT_ENV_DIR/${TF_VAR_parent_prefix}_generated_key.pem"
# Login user on the parent host (its .envrc sets TF_VAR_default_username); used by `lpair`
PARENT_SSH_USER=$(sed -nE 's/^export TF_VAR_default_username="?([^"[:space:]]*)"?.*/\1/p' "$PARENT_ENV_DIR/.envrc" 2>/dev/null | head -n1)
export PARENT_SSH_USER="${PARENT_SSH_USER:-ubuntu}"

# Check for .terraform directory
if [ ! -d .terraform ]; then
  echo "Please run: terraform init"
  return 1
fi

# Fetch the newest AMI. The instance ignores AMI changes after creation (module
# lifecycle), so a newer image here never proposes a rebuild; the banner below
# reports when the running node is behind.
if [ "$AMI_MATCH" = "passed-tag" ]; then
  AMI_LOOKUP_FILTER="Name=tag:Name,Values=${AMI_FILTER}-PASSED"
else
  AMI_LOOKUP_FILTER="Name=name,Values=${AMI_FILTER}"
fi
latest_ami=$(aws ec2 describe-images --region $TF_VAR_region \
 --owners $AMI_OWNER \
 --filters "$AMI_LOOKUP_FILTER" \
 --query 'Images | sort_by(@, &CreationDate) | [-1].ImageId' \
 --output text)

# Validate AMI
if [ "$latest_ami" = 'None' ] || [ -z "$latest_ami" ]; then
 echo "Error: No AMI found matching specified criteria:"
 echo "  Owner: $AMI_OWNER"
 echo "  Filter: $AMI_FILTER (match: $AMI_MATCH)"
 echo "  Region: $TF_VAR_region"
 return 1
fi

# Set AMI and display info
export TF_VAR_gpu_ami=$latest_ami
ami_info=$(aws ec2 describe-images --region $TF_VAR_region \
  --owners $AMI_OWNER \
  --filters "$AMI_LOOKUP_FILTER" \
  --query 'sort_by(Images, &CreationDate)[-1]')

# Determine GPU node state (check instance via AWS API)
export GPU_NODE_NAME="${TF_VAR_parent_prefix}-${TF_VAR_node_name}"
node_json=$(aws ec2 describe-instances --region $TF_VAR_region \
  --filters "Name=tag:Name,Values=${GPU_NODE_NAME}" "Name=instance-state-name,Values=running,stopped,pending,stopping,shutting-down" \
  --query 'Reservations[0].Instances[0].{State:State.Name,Id:InstanceId,PublicIp:PublicIpAddress,PrivateIp:PrivateIpAddress,Image:ImageId}' --output json 2>/dev/null)
node_state=$(echo "$node_json" | jq -r '.State // empty' 2>/dev/null)
node_ami=$(echo "$node_json" | jq -r '.Image // empty' 2>/dev/null)
node_id=$(echo "$node_json" | jq -r '.Id // empty' 2>/dev/null)
node_public_ip=$(echo "$node_json" | jq -r '.PublicIp // empty' 2>/dev/null)
node_private_ip=$(echo "$node_json" | jq -r '.PrivateIp // empty' 2>/dev/null)
# OLLAMA_HOST for this shell: only when the laptop can reach the node directly.
unset OLLAMA_HOST
ollama_status=""
if [ "$OLLAMA_ACCESS" = "vpc+laptop" ] && [ "$node_state" = "running" ] && [ -n "$node_public_ip" ]; then
  export OLLAMA_HOST="http://${node_public_ip}:11434"
  ollama_version=$(curl -fsS --max-time 3 "${OLLAMA_HOST}/api/version" 2>/dev/null | jq -r '.version // empty' 2>/dev/null)
  if [ -n "$ollama_version" ]; then
    ollama_status="server ${ollama_version}"
  else
    ollama_status="unreachable"
  fi
  # Laptop IP drift: the SG holds the /32 from the last apply; compare with the IP right now.
  sg_cidr=$(jq -r '[.resources[] | select(.type=="aws_security_group" and .name=="ollama")][0].instances[0].attributes.ingress[0].cidr_blocks[0] // empty' terraform.tfstate 2>/dev/null)
  if [ -n "$sg_cidr" ] && [ "$sg_cidr" != "${TF_VAR_my_ip}/32" ]; then
    ollama_status="${ollama_status}; ⚠️  laptop IP changed since last apply (SG allows ${sg_cidr}); run: terraform plan && terraform apply"
  fi
fi

case "$node_state" in
  "running") env_status="🟢 ACTIVE" ;;
  "stopped") env_status="🟡 STOPPED" ;;
  "pending"|"stopping"|"shutting-down") env_status="🔄 TRANSITIONING" ;;
  "") env_status="🔴 NOT CREATED" ;;
  *) env_status="🔵 PROVISIONED" ;;
esac

echo ""
echo "======================================================================"
echo "🎮 GPU Node: $(basename $PWD) | Status: $env_status"
echo "----------------------------------------------------------------------"
echo " - Parent Env: $PARENT_ENV_DIR ($TF_VAR_parent_prefix)"
echo " - Parent Subnet: $TF_VAR_parent_subnet_id"
echo " - Node Name: $GPU_NODE_NAME"
echo " - Hostname: $TF_VAR_hostname"
if [ -n "$GPU_PRIVATE_IP" ]; then echo " - Private IP: $GPU_PRIVATE_IP (pinned)"; fi
if [ -s "$PAIRED_KEYS_FILE" ]; then
  echo " - Paired keys: $(grep -cvE '^\s*(#|$)' "$PAIRED_KEYS_FILE") from paired_keys.pub (baked at boot)"
else
  echo " - Paired keys: none yet (run lpair to trust the parent host)"
fi
echo " - Instance Type: $TF_VAR_instance_type (on-demand)"
echo " - Newest AMI: $TF_VAR_gpu_ami ($(echo "$ami_info" | jq -r '.Name'), match: $AMI_MATCH)"
if [ -n "$node_ami" ]; then
  if [ "$node_ami" = "$TF_VAR_gpu_ami" ]; then
    echo " - Running AMI: $node_ami (current)"
  else
    echo " - Running AMI: $node_ami"
    echo "   ⚠️  Newer GPU image available. The node ignores AMI changes by design;"
    echo "      rebuild deliberately (root volume is recreated):"
    echo "      terraform apply -replace=module.gpu_node.aws_instance.this"
  fi
fi
echo " - Region: $TF_VAR_region"
echo " - Default User: $TF_VAR_default_username"
if [ -n "$node_id" ]; then
  echo " - Instance ID: $node_id"
fi
if [ -n "$node_public_ip" ]; then
  echo " - Public IP: $node_public_ip"
fi
if [ -n "$node_private_ip" ]; then
  echo " - Private IP: $node_private_ip"
fi
echo " - SSH Key: $SSH_KEY_PATH"
case "$OLLAMA_ACCESS" in
  tunnel)
    echo " - Ollama: loopback only; ssh -L 11434:127.0.0.1:11434 by hand (laptop and cdw)" ;;
  vpc)
    echo " - Ollama: VPC clients via http://${node_private_ip:-<private-ip>}:11434 (cdw: http://gpu:11434 after lpair); laptop: tunnel by hand" ;;
  vpc+laptop)
    echo " - Ollama (VPC): http://${node_private_ip:-<private-ip>}:11434 (cdw: http://gpu:11434 after lpair)"
    if [ -n "${OLLAMA_HOST:-}" ]; then
      echo " - OLLAMA_HOST: ${OLLAMA_HOST} (${ollama_status}); OpenAI-compatible: ${OLLAMA_HOST}/v1"
    else
      echo " - OLLAMA_HOST: not set (node not running); allowed client: ${TF_VAR_my_ip}/32"
    fi ;;
esac
if [ -n "$node_id" ]; then
  echo " - SSM: aws ssm start-session --region $TF_VAR_region --target $node_id"
fi
echo "======================================================================"
echo ""

# Centralized cloudberry tools (direnv-compatible functions)
REPO_ROOT="$(cd __REPO_ROOT_RELPATH__ && pwd)"
