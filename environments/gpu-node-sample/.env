# .env for a gpu-node sidecar
# Loaded by the zsh dotenv hook on directory entry (aliases + functions).
# direnv loads .envrc first and exports: TF_VAR_region, TF_VAR_parent_prefix,
# TF_VAR_node_name, TF_VAR_default_username, GPU_NODE_NAME, SSH_KEY_PATH,
# OLLAMA_ACCESS, SSO_PROFILE. Everything here resolves the node live by its
# Name tag, so stop/start and public-IP changes need no cache refresh.
#
# Same names as the database environments so muscle memory works:
#   lw / lssh / lcopyto / lcopyfrom      wait for SSH, SSH in, scp to/from
#   istate / istart / istop / istatus    instance lifecycle
#   lssm                                 SSM Session Manager (no port 22 needed)
#   lnvidia / lnvtop / lbtop             GPU and host monitors over SSH
#   lpair                                pair the parent host (cdw) with this node
#   myip / isso                          utilities
# Ollama itself needs no alias: in vpc+laptop mode .envrc exports OLLAMA_HOST while
# the node runs, so `ollama list`, `curl $OLLAMA_HOST/api/version`, and SDKs just work.

# =============================================================================
# CORE FUNCTIONS
# =============================================================================

_gpu_node_query() {
  # _gpu_node_query <JMESPath> [state-list]  -> first match, or empty
  local query="$1" states="${2:-running}"
  aws ec2 describe-instances --region "$TF_VAR_region" \
    --filters "Name=tag:Name,Values=${GPU_NODE_NAME}" \
              "Name=instance-state-name,Values=${states}" \
    --query "Reservations[*].Instances[*].${query}" \
    --output text 2>/dev/null | head -n1
}

get_instance_ip() {
  local ip
  ip=$(_gpu_node_query PublicIpAddress)
  if [[ -n "$ip" && "$ip" != "None" ]]; then
    echo "$ip"
  else
    echo "❌ No running instance found for ${GPU_NODE_NAME}" >&2
    return 1
  fi
}

get_instance_private_ip() {
  local ip
  ip=$(_gpu_node_query PrivateIpAddress)
  [[ -n "$ip" && "$ip" != "None" ]] && echo "$ip" || { echo "❌ No running instance found for ${GPU_NODE_NAME}" >&2; return 1; }
}

get_instance_id() {
  local id
  id=$(_gpu_node_query InstanceId "running,stopped,pending,stopping")
  [[ -n "$id" && "$id" != "None" ]] && echo "$id" || { echo "❌ No instance found for ${GPU_NODE_NAME}" >&2; return 1; }
}

# Wait for SSH on the node's public IP. Returns non-zero instead of exiting
# the shell (this runs in an interactive session).
wait_for_ssh() {
  local hostname i
  hostname=$(get_instance_ip) || return 1
  echo "⏳ Waiting for SSH to become available on ${hostname}..."
  for ((i=1; i<=30; i++)); do
    if command -v timeout >/dev/null 2>&1; then
      timeout 5 nc -z "$hostname" 22 2>/dev/null && { echo "✅ SSH is available on ${hostname}"; return 0; }
    else
      nc -z -G 5 "$hostname" 22 2>/dev/null && { echo "✅ SSH is available on ${hostname}"; return 0; }
    fi
    echo "⏳ SSH not ready (attempt $i/30). Retrying..."
    sleep $((i*2))
  done
  echo "❌ SSH is still not available after 30 attempts." >&2
  return 1
}

# SSH connection options with timeouts (as array for proper expansion)
SSH_OPTS=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 -o LogLevel=ERROR)

# NOTE: SSH_KEY_PATH is set in .envrc (the parent environment's generated key)

# =============================================================================
# SSH + FILE TRANSFER
# =============================================================================

alias lw='wait_for_ssh'
alias lssh='ssh "${SSH_OPTS[@]}" -i ${SSH_KEY_PATH} ${TF_VAR_default_username}@$(get_instance_ip) -A'

alias lcopyto='function _lcopyto() {
  echo "📤 Copying $1 to ${TF_VAR_default_username}@$(get_instance_ip):$2"
  scp "${SSH_OPTS[@]}" -i ${SSH_KEY_PATH} "$1" ${TF_VAR_default_username}@$(get_instance_ip):"$2"
}; _lcopyto'

alias lcopyfrom='function _lcopyfrom() {
  echo "📥 Copying ${TF_VAR_default_username}@$(get_instance_ip):$1 to $2"
  scp "${SSH_OPTS[@]}" -i ${SSH_KEY_PATH} ${TF_VAR_default_username}@$(get_instance_ip):"$1" "$2"
}; _lcopyfrom'

# SSM Session Manager (fallback when port 22 is unreachable; needs session-manager-plugin)
alias lssm='aws ssm start-session --region "$TF_VAR_region" --target $(get_instance_id)'

# =============================================================================
# INSTANCE MANAGEMENT
# =============================================================================

alias istate='aws ec2 describe-instances --region "$TF_VAR_region" \
  --filters "Name=tag:Name,Values=${GPU_NODE_NAME}" "Name=instance-state-name,Values=pending,running,stopping,stopped" \
  --query "Reservations[*].Instances[*].{Name:Tags[?Key==\`Name\`]|[0].Value,State:State.Name,Type:InstanceType,PublicIP:PublicIpAddress,PrivateIP:PrivateIpAddress,AMI:ImageId,Id:InstanceId}" \
  --output table'

alias istatus='echo "📊 ${GPU_NODE_NAME} Status:" && istate'

alias istart='function _istart() {
  local id; id=$(get_instance_id) || return 1
  echo "🚀 Starting ${GPU_NODE_NAME} (${id})..."
  aws ec2 start-instances --region "$TF_VAR_region" --instance-ids "$id" --output text --query "StartingInstances[].CurrentState.Name"
  echo "ℹ️  Public IP changes on every start (no EIP). lw / lssh resolve it live."
  echo "ℹ️  Once running, run: direnv reload   (refreshes OLLAMA_HOST and the banner in this shell)"
}; _istart'

alias istop='function _istop() {
  local id; id=$(get_instance_id) || return 1
  echo "🛑 Stopping ${GPU_NODE_NAME} (${id})..."
  aws ec2 stop-instances --region "$TF_VAR_region" --instance-ids "$id" --output text --query "StoppingInstances[].CurrentState.Name"
}; _istop'

alias irefresh='echo "ℹ️  No IP cache on the GPU sidecar; every alias resolves the node live by tag."'

# =============================================================================
# GPU + OLLAMA
# =============================================================================

alias lnvidia='ssh "${SSH_OPTS[@]}" -i ${SSH_KEY_PATH} ${TF_VAR_default_username}@$(get_instance_ip) nvidia-smi'
alias lnvtop='ssh "${SSH_OPTS[@]}" -t -i ${SSH_KEY_PATH} ${TF_VAR_default_username}@$(get_instance_ip) nvtop'
alias lbtop='ssh "${SSH_OPTS[@]}" -t -i ${SSH_KEY_PATH} ${TF_VAR_default_username}@$(get_instance_ip) btop'

# =============================================================================
# UTILITIES
# =============================================================================

alias myip='echo $(curl -s https://api.ipify.org)'
alias isso='aws sso login --sso-session "${SSO_PROFILE:-sso-profile}"'

# =============================================================================
# PAIRING WITH THE PARENT HOST (cdw)
# =============================================================================
# lpair [--dry-run]
#   1. fetches the parent host's ~/.ssh/id_ed25519.pub (creating the key there if
#      missing) into ./paired_keys.pub -> baked into the node at next apply/rebuild
#   2. on the parent host: writes ~/.ssh/config.d/gpu.conf (Host gpu), the
#      /etc/hosts line for the node's private IP (pinned, or live if not pinned),
#      and /etc/profile.d/ollama-host.sh exporting OLLAMA_HOST=http://gpu:11434
#      for login shells (when OLLAMA_ACCESS is vpc or vpc+laptop)
#   3. if the node is running now: appends the key to its authorized_keys
#   4. verifies: parent host -> ssh gpu hostname
# Idempotent. Re-run after a rebuild only if the node was created before the key
# was in paired_keys.pub.
lpair() {
  local dry=0; [[ "${1:-}" == "--dry-run" ]] && dry=1
  local parent_ip node_ip gpu_ip pub
  parent_ip=$(aws ec2 describe-instances --region "$TF_VAR_region" \
    --filters "Name=tag:Name,Values=${TF_VAR_parent_prefix}-instance-0" "Name=instance-state-name,Values=running" \
    --query "Reservations[*].Instances[*].PublicIpAddress" --output text 2>/dev/null | head -n1)
  if [[ -z "$parent_ip" || "$parent_ip" == "None" ]]; then
    echo "❌ parent host ${TF_VAR_parent_prefix}-instance-0 is not running" >&2; return 1
  fi
  if [[ -n "${GPU_PRIVATE_IP:-}" ]]; then
    gpu_ip="$GPU_PRIVATE_IP"
  else
    gpu_ip=$(get_instance_private_ip 2>/dev/null) || { echo "❌ no pinned private IP and the node is not running; set GPU_PRIVATE_IP in .envrc or start the node" >&2; return 1; }
    echo "⚠️  private IP is not pinned; ${gpu_ip} changes on rebuild (set GPU_PRIVATE_IP in .envrc to pin it)"
  fi
  echo "parent host: ${PARENT_SSH_USER}@${parent_ip}   node: ${GPU_NODE_NAME} at ${gpu_ip}"
  if (( dry )); then
    echo "[dry-run] would fetch ${PARENT_SSH_USER}@${parent_ip}:~/.ssh/id_ed25519.pub -> ${PAIRED_KEYS_FILE}"
    echo "[dry-run] would write on the parent: ~/.ssh/config.d/gpu.conf (Host gpu -> ${gpu_ip}), /etc/hosts '${gpu_ip} gpu'"
    if [[ "$OLLAMA_ACCESS" != "tunnel" ]]; then echo "[dry-run] would write on the parent: /etc/profile.d/ollama-host.sh (OLLAMA_HOST=http://gpu:11434)"; fi
    echo "[dry-run] would append the key to ubuntu@<node>:~/.ssh/authorized_keys if the node is running"
    return 0
  fi

  echo "1/4 fetching the parent host's public key..."
  pub=$(ssh "${SSH_OPTS[@]}" -i "$SSH_KEY_PATH" "${PARENT_SSH_USER}@${parent_ip}" \
    '[ -f ~/.ssh/id_ed25519.pub ] || ssh-keygen -q -t ed25519 -N "" -f ~/.ssh/id_ed25519 </dev/null; cat ~/.ssh/id_ed25519.pub') || { echo "❌ could not read the parent host key" >&2; return 1; }
  [[ "$pub" == ssh-ed25519\ * ]] || { echo "❌ unexpected key material from the parent host" >&2; return 1; }
  touch "$PAIRED_KEYS_FILE"
  if grep -qxF "$pub" "$PAIRED_KEYS_FILE"; then
    echo "    already in paired_keys.pub"
  else
    echo "$pub" >> "$PAIRED_KEYS_FILE"; echo "    saved to paired_keys.pub (baked into the node at next apply/rebuild; re-enter the directory so direnv exports it)"
  fi
  echo "    fingerprint: $(echo "$pub" | ssh-keygen -lf - | awk '{print $2}')"

  echo "2/4 writing the parent host's side (Host gpu, /etc/hosts, OLLAMA_HOST)..."
  ssh "${SSH_OPTS[@]}" -i "$SSH_KEY_PATH" "${PARENT_SSH_USER}@${parent_ip}" "GPU_IP='${gpu_ip}' OLLAMA_ACCESS='${OLLAMA_ACCESS}' bash -s" <<'REMOTE'
set -e
mkdir -p ~/.ssh/config.d && chmod 700 ~/.ssh ~/.ssh/config.d
touch ~/.ssh/config && chmod 600 ~/.ssh/config
if ! grep -qE '^Include ~/.ssh/config.d/\*\.conf' ~/.ssh/config; then
  { echo 'Include ~/.ssh/config.d/*.conf'; echo; cat ~/.ssh/config; } > ~/.ssh/config.new && mv ~/.ssh/config.new ~/.ssh/config && chmod 600 ~/.ssh/config
fi
cat > ~/.ssh/config.d/gpu.conf <<CFG
# GPU sidecar node (written by lpair)
Host gpu ${GPU_IP}
  HostName ${GPU_IP}
  User ubuntu
  IdentityFile ~/.ssh/id_ed25519
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR
CFG
chmod 600 ~/.ssh/config.d/gpu.conf
sudo sed -i -E '/[[:space:]]gpu([[:space:]]|$)/d' /etc/hosts
echo "${GPU_IP} gpu" | sudo tee -a /etc/hosts >/dev/null
echo "    Host gpu -> ${GPU_IP}; /etc/hosts updated"
if [ "${OLLAMA_ACCESS}" != "tunnel" ]; then
  printf '%s\n' '# written by lpair (gpu-node sidecar): Ollama on the GPU node, reachable inside the VPC' \
                 'export OLLAMA_HOST=http://gpu:11434' | sudo tee /etc/profile.d/ollama-host.sh >/dev/null
  sudo chmod 0644 /etc/profile.d/ollama-host.sh
  echo "    /etc/profile.d/ollama-host.sh -> OLLAMA_HOST=http://gpu:11434 (new login shells)"
else
  sudo rm -f /etc/profile.d/ollama-host.sh
fi
REMOTE

  echo "3/4 authorizing the key on the node (if running)..."
  if node_ip=$(get_instance_ip 2>/dev/null); then
    ssh "${SSH_OPTS[@]}" -i "$SSH_KEY_PATH" "${TF_VAR_default_username}@${node_ip}" \
      "grep -qxF '$pub' ~/.ssh/authorized_keys 2>/dev/null && echo '    already authorized' || { echo '$pub' >> ~/.ssh/authorized_keys && echo '    authorized'; }"
  else
    echo "    node not running; the key is baked in at the next apply (paired_keys.pub)"
  fi

  echo "4/4 verifying parent host -> gpu..."
  if [[ -n "${node_ip:-}" ]]; then
    ssh "${SSH_OPTS[@]}" -i "$SSH_KEY_PATH" "${PARENT_SSH_USER}@${parent_ip}" \
      'ssh -o BatchMode=yes -o ConnectTimeout=8 gpu "echo \"    ok: \$(whoami)@\$(hostname) \$(uname -m)\""' || echo "    ❌ parent host cannot log in to gpu yet"
  else
    echo "    skipped (node not running)"
  fi
}
